diff --git a/androidApp/src/main/java/com/maxrave/simpmusic/LegacyDhunoraMigration.kt b/androidApp/src/main/java/com/maxrave/simpmusic/LegacyDhunoraMigration.kt
new file mode 100644
index 0000000..7852ced
--- /dev/null
+++ b/androidApp/src/main/java/com/maxrave/simpmusic/LegacyDhunoraMigration.kt
@@ -0,0 +1,57 @@
+package com.maxrave.simpmusic
+
+import android.content.Context
+import android.net.Uri
+import com.maxrave.data.db.MusicDatabase
+import com.maxrave.domain.data.entities.LocalPlaylistEntity
+import com.maxrave.domain.data.entities.SearchHistory
+import com.maxrave.domain.data.entities.SongEntity
+import org.json.JSONArray
+import org.json.JSONObject
+import org.koin.mp.KoinPlatform.getKoin
+
+/** Imports the old Dhunora library once without deleting its original preferences. */
+internal object LegacyDhunoraMigration {
+    suspend fun migrate(context: Context) {
+        val migration = context.getSharedPreferences("dhunora_migration", Context.MODE_PRIVATE)
+        if (migration.getBoolean("simp_v1", false)) return
+        val playlistPrefs = context.getSharedPreferences("dhunora_playlists", Context.MODE_PRIVATE)
+        val profile = context.getSharedPreferences("dhunora_listening_profile", Context.MODE_PRIVATE)
+        val playlist = parseSongs(playlistPrefs.getString("My Playlist", "[]") ?: "[]")
+        val recent = parseSongs(profile.getString("recent", "[]") ?: "[]")
+        val searches = JSONArray(profile.getString("searches", "[]") ?: "[]")
+        val dao = getKoin().get<MusicDatabase>().getDatabaseDao()
+        (playlist + recent).distinctBy { it.videoId }.forEach { dao.insertSong(it) }
+        if (playlist.isNotEmpty()) {
+            // Fixed id makes retries safe even if the process dies before the completion marker.
+            dao.insertLocalPlaylistWithTracks(
+                LocalPlaylistEntity(id = -170001L, title = "My Playlist", tracks = playlist.map { it.videoId }),
+                playlist.map { it.videoId },
+            )
+        }
+        for (i in 0 until searches.length()) {
+            searches.optString(i).trim().takeIf { it.isNotEmpty() }?.let { dao.insertSearchHistory(SearchHistory(it)) }
+        }
+        check(migration.edit().putBoolean("simp_v1", true).commit())
+    }
+
+    private fun parseSongs(raw: String): List<SongEntity> {
+        val items = JSONArray(raw)
+        return (0 until items.length()).mapNotNull { i -> items.optJSONObject(i)?.toSong() }
+            .distinctBy { it.videoId }
+    }
+
+    private fun JSONObject.toSong(): SongEntity? {
+        val uri = runCatching { Uri.parse(optString("url")) }.getOrNull() ?: return null
+        val id = uri.getQueryParameter("v") ?: uri.lastPathSegment ?: return null
+        if (!id.matches(Regex("[A-Za-z0-9_-]{11}"))) return null
+        val seconds = optInt("duration").coerceAtLeast(0)
+        return SongEntity(
+            videoId = id, artistName = listOf(optString("artist")),
+            title = optString("title"), duration = "%d:%02d".format(seconds / 60, seconds % 60),
+            durationSeconds = seconds, isAvailable = true, isExplicit = false,
+            likeStatus = "INDIFFERENT", thumbnails = optString("thumb").takeIf { it.isNotBlank() },
+            videoType = "MUSIC_VIDEO_TYPE_ATV", category = null, resultType = "song",
+        )
+    }
+}
